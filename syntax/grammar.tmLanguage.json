{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Todo",
    "scopeName": "text.todo",
    "fileTypes": ["TODO", "todolist.txt", "todo", "todos", "task", "tasks", "taskpaper"],
    "patterns": [
        { "include": "#done" },
        { "include": "#cancelled" },
        { "include": "#started" },
        { "include": "#pending" },
        { "include": "#project" },
        { "include": "#comment" }
    ],
    "repository": {
        "cancelled": {
            "begin": "^(?=\\s*(?:✘\\s|(?:☐|-\\s+\\[ \\])\\s(?:(?:[^`\\r\\n]|(`+)(?!`)(?:(?!(?<!`)\\1(?!`))[^\\r\\n])*(?<!`)\\1(?!`)|(`+)(?!`)(?![^\\r\\n]*(?<!`)\\2(?!`))))*?(?<![A-Za-z0-9])@cancelled(?:\\([^)]*\\))?(?![A-Za-z])))",
            "end": "$",
            "name": "markup.deleted.todo",
            "patterns": [{ "include": "#inline" }]
        },
        "done": {
            "begin": "^(?=\\s*(?:✔\\s|-\\s+\\[[xX]\\]\\s|(?:☐|-\\s+\\[ \\])\\s(?:(?:[^`\\r\\n]|(`+)(?!`)(?:(?!(?<!`)\\1(?!`))[^\\r\\n])*(?<!`)\\1(?!`)|(`+)(?!`)(?![^\\r\\n]*(?<!`)\\2(?!`))))*?(?<![A-Za-z0-9])@done(?:\\([^)]*\\))?(?![A-Za-z])))",
            "end": "$",
            "name": "markup.inserted.todo",
            "patterns": [{ "include": "#inline" }]
        },
        "started": {
            "begin": "^(?=\\s*(?:☐|-\\s+\\[ \\])\\s(?:(?:[^`\\r\\n]|(`+)(?!`)(?:(?!(?<!`)\\1(?!`))[^\\r\\n])*(?<!`)\\1(?!`)|(`+)(?!`)(?![^\\r\\n]*(?<!`)\\2(?!`))))*?(?<![A-Za-z0-9])@started(?:\\([^)]*\\))?(?![A-Za-z]))",
            "end": "$",
            "name": "markup.changed.todo",
            "patterns": [{ "include": "#inline" }]
        },
        "pending": {
            "begin": "^(?=\\s*(?:☐|-\\s+\\[ \\])\\s)",
            "end": "$",
            "name": "markup.list.unchecked.todo",
            "patterns": [{ "include": "#inline" }]
        },
        "project": {
            "begin": "^(?=\\s*(?!(?:☐|✔|✘|-\\s+\\[[ xX]\\])\\s).+:(?=\\s*(?:@|$)))",
            "end": "$",
            "name": "markup.heading.todo",
            "patterns": [{ "include": "#inline" }]
        },
        "comment": {
            "begin": "^(?=\\s*\\S)",
            "end": "$",
            "name": "comment.line.todo",
            "patterns": [{ "include": "#inline" }]
        },
        "inline": {
            "patterns": [
                { "include": "#code" },
                { "include": "#bold" },
                { "include": "#italic" },
                { "include": "#strikethrough" },
                { "include": "#tag" }
            ]
        },
        "code": {
            "match": "(?<![A-Za-z0-9])(`+)(.+?)\\1(?![A-Za-z0-9])",
            "name": "markup.inline.raw.todo"
        },
        "bold": {
            "match": "(?<![A-Za-z0-9*])\\*[^\\n*]+\\*(?![A-Za-z0-9*])",
            "name": "markup.bold.todo"
        },
        "italic": {
            "match": "(?<![A-Za-z0-9_])_[^\\n_]+_(?![A-Za-z0-9_])",
            "name": "markup.italic.todo"
        },
        "strikethrough": {
            "match": "(?<![A-Za-z0-9~])~[^\\n~]+~(?![A-Za-z0-9~])",
            "name": "markup.strikethrough.todo"
        },
        "tag": {
            "match": "(?<![A-Za-z0-9`])@[^\\s*~(]+(?:://[^\\s*~(:]+)?(?:\\([^)]*\\))?",
            "name": "entity.name.tag.todo"
        }
    }
}
