{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "pnpm: compile:watch",
            "type": "shell",
            "command": "pnpm",
            "args": ["run", "compile:watch", "--infrastructure-logging-level", "log"],
            "isBackground": true,
            "group": "build",
            "problemMatcher": {
                "owner": "webpack",
                "pattern": {
                    "regexp": "^.*$",
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "\\[webpack-cli\\] Compiler.* starting",
                    "endsPattern": "webpack .* compiled",
                },
            },
        },
        {
            "label": "terminate build",
            "command": "${command:workbench.action.tasks.terminate}",
            "type": "process",
            "problemMatcher": [],
        },
    ],
}
